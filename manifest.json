{
  "plugin_id": "silo.requests.arr",
  "version": "0.1.0",
  "checksum": "__CHECKSUM__",
  "silo_api_version": "v1",
  "presentation": {
    "display_name": "Sonarr & Radarr Requests",
    "summary": "Route movie and series requests to one or more Sonarr and Radarr instances.",
    "description_markdown": "Fulfills approved Silo requests directly through Sonarr and Radarr. Multiple connections can cover HD and 4K libraries, different root folders and quality profiles, tags, search behavior, and dedicated anime overrides.",
    "setup_markdown": "Install the plugin, then add Sonarr and Radarr connections in Silo with each service URL and API key. Configure the root folder, quality profile, tags, default and 4K roles, and any anime overrides for each connection. The plugin is stateless; Silo supplies credentials for every request.",
    "homepage_url": "https://github.com/Silo-Community/silo-plugins-requests-arr",
    "source_url": "https://github.com/Silo-Community/silo-plugins-requests-arr",
    "support_url": "https://github.com/Silo-Community/silo-plugins-requests-arr/issues",
    "changelog_url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases",
    "publisher_name": "Silo Community",
    "publisher_url": "https://github.com/Silo-Community",
    "license_spdx": "AGPL-3.0-only"
  },
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "linux",
      "arch": "arm64"
    },
    {
      "os": "darwin",
      "arch": "arm64"
    }
  ],
  "capabilities": [
    {
      "type": "request_router.v1",
      "id": "arr",
      "display_name": "Sonarr / Radarr",
      "description": "Fulfills movie/series requests against multi-instance Sonarr/Radarr.",
      "request_router": {
        "supports_seasons": true,
        "reports_download_progress": true
      },
      "config_schema": [
        {
          "key": "connection",
          "title": "Connection",
          "json_schema": "{\"type\":\"object\",\"properties\":{\"service_kind\":{\"type\":\"string\"},\"root_folder\":{\"type\":\"string\"},\"quality_profile_id\":{\"type\":\"integer\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}},\"is_default\":{\"type\":\"boolean\"},\"is_4k\":{\"type\":\"boolean\"},\"is_default_4k\":{\"type\":\"boolean\"},\"search_on_add\":{\"type\":\"boolean\"},\"monitor\":{\"type\":\"string\"},\"minimum_availability\":{\"type\":\"string\"},\"series_type\":{\"type\":\"string\"},\"season_folder\":{\"type\":\"boolean\"},\"anime_enabled\":{\"type\":\"boolean\"},\"anime_root_folder\":{\"type\":\"string\"},\"anime_quality_profile_id\":{\"type\":\"integer\"},\"anime_tags\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}}}",
          "admin_form": {
            "submit_label": "Save connection",
            "fields": [
              {
                "key": "service_kind",
                "label": "Service",
                "description": "Detected from the server when it connects.",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "required": true,
                "options": [
                  {
                    "value": "radarr",
                    "label": "Radarr (movies)"
                  },
                  {
                    "value": "sonarr",
                    "label": "Sonarr (series)"
                  }
                ]
              },
              {
                "key": "root_folder",
                "label": "Root folder",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "dynamic_options": true
              },
              {
                "key": "quality_profile_id",
                "label": "Quality profile",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "required": true,
                "dynamic_options": true
              },
              {
                "key": "tags",
                "label": "Tags",
                "control": "ADMIN_FORM_CONTROL_MULTI_SELECT",
                "dynamic_options": true
              },
              {
                "key": "is_default",
                "label": "Default (HD/1080p)",
                "control": "ADMIN_FORM_CONTROL_SWITCH",
                "exclusive_group_field": "service_kind"
              },
              {
                "key": "is_4k",
                "label": "4K instance",
                "control": "ADMIN_FORM_CONTROL_SWITCH"
              },
              {
                "key": "is_default_4k",
                "label": "Default 4K (2160p)",
                "control": "ADMIN_FORM_CONTROL_SWITCH",
                "show_when": [
                  {
                    "field": "is_4k",
                    "equals": [
                      "true"
                    ]
                  }
                ],
                "exclusive_group_field": "service_kind"
              },
              {
                "key": "search_on_add",
                "label": "Search on add",
                "control": "ADMIN_FORM_CONTROL_SWITCH",
                "default_value": true
              },
              {
                "key": "monitor",
                "label": "Monitor",
                "description": "Episodes Sonarr monitors when a series is added. With Search on add on, Sonarr immediately searches every monitored episode that has aired, so All episodes searches a long-running show's entire back catalog. A request for particular seasons monitors and searches only those seasons instead.",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "default_value": "all",
                "show_when": [
                  {
                    "field": "service_kind",
                    "equals": [
                      "sonarr"
                    ]
                  }
                ],
                "options": [
                  {
                    "value": "all",
                    "label": "All episodes"
                  },
                  {
                    "value": "future",
                    "label": "Future episodes"
                  },
                  {
                    "value": "recent",
                    "label": "Recent episodes (last 90 days and future)"
                  },
                  {
                    "value": "lastSeason",
                    "label": "Last season"
                  },
                  {
                    "value": "firstSeason",
                    "label": "First season"
                  },
                  {
                    "value": "pilot",
                    "label": "Pilot episode"
                  }
                ]
              },
              {
                "key": "minimum_availability",
                "label": "Minimum availability",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "default_value": "released",
                "show_when": [
                  {
                    "field": "service_kind",
                    "equals": [
                      "radarr"
                    ]
                  }
                ],
                "options": [
                  {
                    "value": "announced",
                    "label": "Announced"
                  },
                  {
                    "value": "inCinemas",
                    "label": "In cinemas"
                  },
                  {
                    "value": "released",
                    "label": "Released"
                  }
                ]
              },
              {
                "key": "series_type",
                "label": "Series type",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "default_value": "standard",
                "show_when": [
                  {
                    "field": "service_kind",
                    "equals": [
                      "sonarr"
                    ]
                  }
                ],
                "options": [
                  {
                    "value": "standard",
                    "label": "Standard"
                  },
                  {
                    "value": "daily",
                    "label": "Daily"
                  },
                  {
                    "value": "anime",
                    "label": "Anime"
                  }
                ]
              },
              {
                "key": "season_folder",
                "label": "Season folder",
                "control": "ADMIN_FORM_CONTROL_SWITCH",
                "default_value": true,
                "show_when": [
                  {
                    "field": "service_kind",
                    "equals": [
                      "sonarr"
                    ]
                  }
                ]
              },
              {
                "key": "anime_enabled",
                "label": "Enable anime overrides",
                "control": "ADMIN_FORM_CONTROL_SWITCH"
              },
              {
                "key": "anime_root_folder",
                "label": "Anime root folder",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "dynamic_options": true,
                "show_when": [
                  {
                    "field": "anime_enabled",
                    "equals": [
                      "true"
                    ]
                  }
                ]
              },
              {
                "key": "anime_quality_profile_id",
                "label": "Anime quality profile",
                "control": "ADMIN_FORM_CONTROL_SELECT",
                "dynamic_options": true,
                "show_when": [
                  {
                    "field": "anime_enabled",
                    "equals": [
                      "true"
                    ]
                  }
                ]
              },
              {
                "key": "anime_tags",
                "label": "Anime tags",
                "control": "ADMIN_FORM_CONTROL_MULTI_SELECT",
                "dynamic_options": true,
                "show_when": [
                  {
                    "field": "anime_enabled",
                    "equals": [
                      "true"
                    ]
                  }
                ]
              }
            ],
            "sections": [
              {
                "key": "library",
                "title": "Library",
                "collapsible": true,
                "collapsed_default": true,
                "field_keys": [
                  "service_kind",
                  "root_folder",
                  "quality_profile_id",
                  "tags",
                  "is_default",
                  "is_4k",
                  "is_default_4k",
                  "search_on_add",
                  "monitor",
                  "minimum_availability",
                  "series_type",
                  "season_folder"
                ]
              },
              {
                "key": "anime",
                "title": "Anime overrides",
                "collapsible": false,
                "collapsed_default": false,
                "field_keys": [
                  "anime_enabled",
                  "anime_root_folder",
                  "anime_quality_profile_id",
                  "anime_tags"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "global_config_schema": []
}
